rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /photos/{photoId} {
      // Galeri awam: semua orang boleh melihat dan download URL gambar.
      allow read: if true;

      // Tetamu boleh mencipta rekod gambar dengan medan yang dibenarkan sahaja.
      allow create: if
        request.resource.data.keys().hasAll([
          'imageUrl', 'uploaderName', 'timestamp', 'likes'
        ]) &&
        request.resource.data.keys().hasOnly([
          'imageUrl', 'uploaderName', 'timestamp', 'likes'
        ]) &&
        request.resource.data.uploaderName is string &&
        request.resource.data.uploaderName.size() > 0 &&
        request.resource.data.uploaderName.size() <= 100 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.matches('https://i\\.ibb\\.co/.*') &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.likes == 0;

      // Like sahaja boleh diubah melalui browser. Delete dilakukan oleh Cloud Function.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
        request.resource.data.likes is int &&
        request.resource.data.likes == resource.data.get('likes', 0) + 1;

      allow delete: if false;
    }

    // Maklumat rahsia untuk memadam ImgBB tidak boleh dibaca/ditulis dari browser.
    match /photoSecrets/{photoId} {
      allow read, write: if false;
    }
  }
}
